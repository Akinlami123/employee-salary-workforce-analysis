-- 9. HIGHEST-PAID EMPLOYEE IN EACH DEPARTMENT

SELECT
    department,
    first_name,
    last_name,
    job_title,
    salary
FROM (
    SELECT
        department,
        first_name,
        last_name,
        job_title,
        salary,
        RANK() OVER (
            PARTITION BY department
            ORDER BY salary DESC
        ) AS salary_rank
    FROM employees
) AS ranked_employees
WHERE salary_rank = 1
ORDER BY salary DESC;